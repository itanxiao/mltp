///////////////////////////////////////////////////////////////////////////////
// Configuration file
local.file "endpoints" {
  filename = "/etc/alloy/endpoints.json"
}

livedebugging {
  enabled = false
}

///////////////////////////////////////////////////////////////////////////////
// Metrics remote_write (to Mimir)
prometheus.remote_write "mimir" {
  endpoint {
    url = json_path(local.file.endpoints.content, ".metrics.url")[0]

    basic_auth {
      username = json_path(local.file.endpoints.content, ".metrics.basicAuth.username")[0]
      password = json_path(local.file.endpoints.content, ".metrics.basicAuth.password")[0]
    }
  }
}

///////////////////////////////////////////////////////////////////////////////
// Loki write (for logs)
loki.write "default" {
  endpoint {
    url = json_path(local.file.endpoints.content, ".logs.url")[0]

    basic_auth {
      username = json_path(local.file.endpoints.content, ".logs.basicAuth.username")[0]
      password = json_path(local.file.endpoints.content, ".logs.basicAuth.password")[0]
    }
  }
}

///////////////////////////////////////////////////////////////////////////////
// Tempo exporter auth + exporter (for traces)
otelcol.auth.headers "tempo" {
  header {
    key   = "Authorization"
    value = join(["Basic ", json_path(local.file.endpoints.content, ".traces.basicAuthToken")[0]], "")
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    auth     = otelcol.auth.headers.tempo.handler
    endpoint = json_path(local.file.endpoints.content, ".traces.url")[0]

    tls {
      insecure             = json_path(local.file.endpoints.content, ".traces.tls.insecure")[0]
      insecure_skip_verify = json_path(local.file.endpoints.content, ".traces.tls.insecureSkipVerify")[0]
    }
  }
}

///////////////////////////////////////////////////////////////////////////////
// NEW: add Loki label hints for OTLP logs (generic)
///////////////////////////////////////////////////////////////////////////////
otelcol.processor.attributes "logs_loki_hints" {
  // 对 logs 生效即可（attributes processor 支持 logs）
  action {
    key    = "loki.resource.labels"
    action = "upsert"
    // 把常用资源属性提升为 Loki labels，方便在 Grafana 里按 job/service 查
    value  = "service.name,service.namespace,service.instance.id"
  }

  // 如果你希望把某些 log attributes 也提升为 labels，可按需加（可选）
  // action {
  //   key    = "loki.attribute.labels"
  //   action = "upsert"
  //   value  = "http.method,http.route,exception.type"
  // }

  output {
    logs = [otelcol.processor.batch.default.input]
  }
}

otelcol.receiver.otlp "otlp" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }
  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    // logs 先过 hints，再进 batch
    logs    = [otelcol.processor.attributes.logs_loki_hints.input]
    traces  = [otelcol.processor.batch.default.input]
    metrics = [otelcol.processor.batch.default.input]
  }
}

///////////////////////////////////////////////////////////////////////////////
// Batch processor: common processing for all signals
otelcol.processor.batch "default" {
  send_batch_size     = 1000
  send_batch_max_size = 2000
  timeout             = "2s"

  output {
    // traces -> tempo
    traces = [otelcol.exporter.otlp.tempo.input]

    // metrics -> prometheus exporter -> remote_write
    metrics = [otelcol.exporter.prometheus.otlp_metrics.input]

    // logs -> loki exporter -> loki.write
    logs = [otelcol.exporter.loki.otlp_logs.input]
  }
}

///////////////////////////////////////////////////////////////////////////////
// OTLP logs -> Loki
otelcol.exporter.loki "otlp_logs" {
  forward_to = [loki.write.default.receiver]
}

///////////////////////////////////////////////////////////////////////////////
// OTLP metrics -> Prometheus format -> remote_write
otelcol.exporter.prometheus "otlp_metrics" {
  // 是否要自动加单位后缀：你可以固定 false，或者继续用 endpoints.json 控制
  add_metric_suffixes = false

  forward_to = [prometheus.remote_write.mimir.receiver]
}
